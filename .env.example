# Flask
FLASK_ENV=development
SECRET_KEY=dev-secret-change-me

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Database
# Examples:
# - SQLite: sqlite:///rsistems_chatbot.db
# - Postgres: postgresql+psycopg2://user:pass@host:5432/dbname
DATABASE_URL=sqlite:///rsistems_chatbot.db

# Google Calendar (showroom demo reservations)
# Path to the downloaded service account JSON key file
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=credentials/google-service-account.json
# Calendar ID — find it in Google Calendar settings (looks like xxx@group.calendar.google.com)
GOOGLE_CALENDAR_ID=primary

# Gmail SMTP (confirmation emails)
# Use an App Password — not your regular Gmail password
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_SMTP_USER=your-gmail@gmail.com
GMAIL_SMTP_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

